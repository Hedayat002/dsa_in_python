# 3934. Smallest Unique Subarray
# Difficulty: Hard
# Platform: LeetCode


# =========================================================
# Approach 1: Brute Force + Hash Map
# Time Complexity: O(n^3)
# Space Complexity: O(n^2)
# =========================================================

from typing import List
from collections import Counter

class Solution:
    def smallestUniqueSubarray(self, nums: List[int]) -> int:
        n = len(nums)

        for k in range(1, n + 1):
            mp = Counter()

            for i in range(n - k + 1):
                subarray = tuple(nums[i:i + k])
                mp[subarray] += 1

            for count in mp.values():
                if count == 1:
                    return k

        return n


# =========================================================
# Approach 2: Binary Search + Rolling Hash (My Solution)
# Time Complexity: O(n log n) Expected
# Space Complexity: O(n)
# Note: Single rolling hash may have hash collisions.
# =========================================================

from typing import List

class Solution:

    base = 100007
    mod = 10**9 + 7

    def isPossible(self, nums, k):

        n = len(nums)
        mp = {}

        hash_val = 0
        power = 1

        # First window
        for i in range(k):

            hash_val = (hash_val * self.base + nums[i]) % self.mod

            # Calculate base^(k-1)
            if i < k - 1:
                power = (power * self.base) % self.mod

        mp[hash_val] = 1

        # Sliding window
        for i in range(k, n):

            # Remove left element
            hash_val = (
                hash_val - nums[i-k] * power % self.mod + self.mod
            ) % self.mod

            # Add right element
            hash_val = (hash_val * self.base + nums[i]) % self.mod

            mp[hash_val] = mp.get(hash_val, 0) + 1

        # Check unique subarray
        for val in mp.values():
            if val == 1:
                return True

        return False

    def smallestUniqueSubarray(self, nums: List[int]) -> int:

        left = 1
        right = len(nums)
        ans = len(nums)

        # Binary Search
        while left <= right:

            mid = left + (right - left) // 2

            if self.isPossible(nums, mid):
                ans = mid
                right = mid - 1
            else:
                left = mid + 1

        return ans


# =========================================================
# Approach 3: Optimized Solution - Suffix Automaton
# Time Complexity: O(n) Expected
# Space Complexity: O(n)
# =========================================================

from typing import List

class Solution:
    def smallestUniqueSubarray(self, nums: List[int]) -> int:
        n = len(nums)

        transitions = [{}]
        length = [0]
        link = [-1]
        count = [0]

        last = 0

        # Build Suffix Automaton
        for num in nums:

            curr = len(transitions)

            transitions.append({})
            length.append(length[last] + 1)
            link.append(0)
            count.append(1)

            p = last

            while p != -1 and num not in transitions[p]:
                transitions[p][num] = curr
                p = link[p]

            if p == -1:
                link[curr] = 0

            else:
                q = transitions[p][num]

                if length[p] + 1 == length[q]:
                    link[curr] = q

                else:
                    clone = len(transitions)

                    transitions.append(transitions[q].copy())
                    length.append(length[p] + 1)
                    link.append(link[q])
                    count.append(0)

                    while p != -1 and transitions[p].get(num) == q:
                        transitions[p][num] = clone
                        p = link[p]

                    link[q] = clone
                    link[curr] = clone

            last = curr

        # Group states by length
        buckets = [[] for _ in range(n + 1)]

        for i in range(1, len(transitions)):
            buckets[length[i]].append(i)

        ans = n

        # Propagate occurrence counts
        for k in range(n, 0, -1):

            for state in buckets[k]:

                if count[state] == 1:
                    ans = min(ans, length[link[state]] + 1)

                count[link[state]] += count[state]

        return ans


