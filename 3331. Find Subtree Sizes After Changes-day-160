## 3. Optimized Solution (Iterative DFS + Backtracking)

```python
from typing import List

class Solution:
    def findSubtreeSizes(self, parent: List[int], s: str) -> List[int]:
        n = len(parent)

        adj = [[] for _ in range(n)]

        # Build adjacency list
        for i in range(1, n):
            adj[parent[i]].append(i)

        resultSize = [1] * n
        last = [-1] * 26

        # (node, isExit, nearestAncestor)
        stack = [(0, False, -1)]

        while stack:
            currNode, isExit, nearestAncestor = stack.pop()

            c = ord(s[currNode]) - ord('a')

            if not isExit:
                nearestAncestor = last[c]

                last[c] = currNode

                stack.append((currNode, True, nearestAncestor))

                for child in reversed(adj[currNode]):
                    stack.append((child, False, -1))

            else:
                # Backtrack
                last[c] = nearestAncestor

                if currNode != 0:
                    newParent = parent[currNode]

                    if nearestAncestor != -1:
                        newParent = nearestAncestor

                    resultSize[newParent] += resultSize[currNode]

        return resultSize
```

**Time Complexity:** `O(n)`  
**Space Complexity:** `O(n)`

