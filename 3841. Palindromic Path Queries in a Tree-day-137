import math
class Solution:
    def palindromePath(self, n, edges, s, queries):
        self.n = n
        self.time = 0

        # Build adjacency list
        self.adj = [[] for _ in range(n)]
        for u, v in edges:
            self.adj[u].append(v)
            self.adj[v].append(u)

        # Euler Tour information
        self.tin = [0] * n
        self.tout = [0] * n
        self.depth = [0] * n
        self.eulerTour = [0] * (2 * n)

        # Binary Lifting table
        self.cols = max(1, n.bit_length())
        self.ancestorTable = [
            [-1] * self.cols for _ in range(n)
        ]

        # Store characters as bitmasks
        self.s = list(s)

        # DFS to construct Euler Tour and initialize ancestors
        self.dfs(0, -1, 0)

        # Build Segment Tree
        N = 2 * n
        self.segmentTree = [0] * (4 * N)
        self.buildSegmentTree(0, 0, N - 1)

        # Build Binary Lifting table
        self.buildAncestorTable()

        result = []

        for q in queries:
            parts = q.split()
            query_type = parts[0]

            if query_type == "update":
                node = int(parts[1])
                c = parts[2]

                charValue = 1 << (ord(c) - ord('a'))
                self.s[node] = c

                # Update both occurrences in Euler Tour
                self.updateSegTree(
                    self.tin[node], charValue, 0, 0, 2 * n - 1
                )
                self.updateSegTree(
                    self.tout[node], charValue, 0, 0, 2 * n - 1
                )

            else:
                u = int(parts[1])
                v = int(parts[2])

                lcaNode = self.getLCA(u, v)

                charValue = 1 << (
                    ord(self.s[lcaNode]) - ord('a')
                )

                # XOR of root-to-node paths
                mask = (
                    self.querySegmentTree(
                        0, self.tin[u], 0, 0, 2 * n - 1
                    )
                    ^
                    self.querySegmentTree(
                        0, self.tin[v], 0, 0, 2 * n - 1
                    )
                    ^
                    charValue
                )

                # True if at most one bit is set
                result.append((mask & (mask - 1)) == 0)

        return result

    # DFS: Construct Euler Tour and record depths
    def dfs(self, node, parent, d):
        self.depth[node] = d
        self.ancestorTable[node][0] = parent

        # Entry time
        self.tin[node] = self.time
        self.eulerTour[self.time] = (
            1 << (ord(self.s[node]) - ord('a'))
        )
        self.time += 1

        for child in self.adj[node]:
            if child == parent:
                continue

            self.dfs(child, node, d + 1)

        # Exit time
        self.tout[node] = self.time
        self.eulerTour[self.time] = (
            1 << (ord(self.s[node]) - ord('a'))
        )
        self.time += 1

    # Segment Tree: Build
    def buildSegmentTree(self, i, l, r):
        if l == r:
            self.segmentTree[i] = self.eulerTour[l]
            return

        mid = l + (r - l) // 2

        self.buildSegmentTree(2 * i + 1, l, mid)
        self.buildSegmentTree(2 * i + 2, mid + 1, r)

        self.segmentTree[i] = (
            self.segmentTree[2 * i + 1]
            ^ self.segmentTree[2 * i + 2]
        )

    # Segment Tree: Point Update
    def updateSegTree(self, index, val, i, l, r):
        if l == r:
            self.segmentTree[i] = val
            return

        mid = l + (r - l) // 2

        if index <= mid:
            self.updateSegTree(
                index, val, 2 * i + 1, l, mid
            )
        else:
            self.updateSegTree(
                index, val, 2 * i + 2, mid + 1, r
            )

        self.segmentTree[i] = (
            self.segmentTree[2 * i + 1]
            ^ self.segmentTree[2 * i + 2]
        )

    # Segment Tree: XOR Range Query
    def querySegmentTree(self, start, end, i, l, r):
        if l > end or r < start:
            return 0

        if l >= start and r <= end:
            return self.segmentTree[i]

        mid = l + (r - l) // 2

        return (
            self.querySegmentTree(
                start, end, 2 * i + 1, l, mid
            )
            ^
            self.querySegmentTree(
                start, end, 2 * i + 2, mid + 1, r
            )
        )

    # Binary Lifting: Build Ancestor Table
    def buildAncestorTable(self):
        for j in range(1, self.cols):
            for node in range(self.n):
                prev = self.ancestorTable[node][j - 1]

                if prev != -1:
                    self.ancestorTable[node][j] = (
                        self.ancestorTable[prev][j - 1]
                    )

    # Find LCA using Binary Lifting
    def getLCA(self, u, v):
        if self.depth[u] < self.depth[v]:
            u, v = v, u

        # Make both nodes have the same depth
        diff = self.depth[u] - self.depth[v]

        for j in range(self.cols):
            if diff & (1 << j):
                u = self.ancestorTable[u][j]

        if u == v:
            return u

        # Lift both nodes until their parents are the LCA
        for j in range(self.cols - 1, -1, -1):
            if (
                self.ancestorTable[u][j]
                != self.ancestorTable[v][j]
            ):
                u = self.ancestorTable[u][j]
                v = self.ancestorTable[v][j]

        return self.ancestorTable[u][0]
