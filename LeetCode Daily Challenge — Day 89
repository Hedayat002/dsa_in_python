1.Brute Force:
 class Solution:
    def totalNumbers(self, digits: List[int]) -> int:
        st = set()
        n = len(digits)

        for i in range(n):
            for j in range(n):
                for k in range(n):

                    # Same copy/index cannot be used twice
                    if i == j or j == k or i == k:
                        continue

                    num = digits[i] * 100 + digits[j] * 10 + digits[k]

                    # Must be a 3-digit even number
                    if num >= 100 and num % 2 == 0:
                        st.add(num)

        return len(st)

Time: O(n³ + S log S)
Space: O(S)
S = number of unique 3-digit even numbers generated.

Approach 2 — Smartly find valid digits for each position

class Solution:
    def totalNumbers(self, digits: List[int]) -> int:
        result = []

        # Frequency map for digits 0-9
        mp = [0] * 10

        for digit in digits:
            mp[digit] += 1

        # Hundreds digit: 1-9
        for i in range(1, 10):
            if mp[i] == 0:
                continue

            mp[i] -= 1

            # Tens digit: 0-9
            for j in range(10):
                if mp[j] == 0:
                    continue

                mp[j] -= 1

                # Units digit must be even: 0, 2, 4, 6, 8
                for k in range(0, 10, 2):
                    if mp[k] == 0:
                        continue

                    mp[k] -= 1

                    num = i * 100 + j * 10 + k
                    result.append(num)

                    # Restore units digit
                    mp[k] += 1

                # Restore tens digit
                mp[j] += 1

            # Restore hundreds digit
            mp[i] += 1

        return len(result)

TC: O(n), because we first build the frequency array in O(n), followed by a constant number of digit combinations.
SC: O(1) auxiliary space, excluding the output array.
