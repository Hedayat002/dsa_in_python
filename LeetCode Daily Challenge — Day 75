### 2. Optimal

```python
class Solution:
    def lexPalindromicPermutation(self, s: str, target: str) -> str:
        n = len(s)

        freq = [0] * 26

        for ch in s:
            freq[ord(ch) - ord('a')] += 1

        odd_char = -1
        odd_count = 0

        for i in range(26):
            if freq[i] % 2:
                odd_count += 1
                odd_char = i

        if odd_count > 1:
            return ""

        half_freq = [x // 2 for x in freq]
        half_len = n // 2
        target_left = target[:half_len]

        remaining = half_freq[:]
        equal_prefix = []

        for i in range(half_len):
            idx = ord(target_left[i]) - ord('a')

            if remaining[idx] == 0:
                break

            equal_prefix.append(target_left[i])
            remaining[idx] -= 1
        else:
            left = ''.join(equal_prefix)

            middle = ""
            if odd_count == 1:
                middle = chr(ord('a') + odd_char)

            candidate = left + middle + left[::-1]

            if candidate > target:
                return candidate

        remaining = half_freq[:]

        for i in range(len(equal_prefix)):
            idx = ord(target_left[i]) - ord('a')
            remaining[idx] -= 1

        for i in range(len(equal_prefix) - 1, -1, -1):
            idx = ord(target_left[i]) - ord('a')
            remaining[idx] += 1

            for c in range(idx + 1, 26):
                if remaining[c] == 0:
                    continue

                remaining[c] -= 1

                suffix = []
                for x in range(26):
                    if remaining[x]:
                        suffix.extend(
                            [chr(ord('a') + x)] * remaining[x]
                        )

                left = target_left[:i] + chr(ord('a') + c) + ''.join(suffix)

                middle = ""
                if odd_count == 1:
                    middle = chr(ord('a') + odd_char)

                return left + middle + left[::-1]

        return ""
```

**TC:** `O(n + 26n)` = `O(26n)`
**SC:** `O(n)`
