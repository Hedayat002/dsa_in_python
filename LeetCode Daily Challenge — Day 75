## ASCII Algorithm

```text
Start
  ↓
Count characters in s
  ↓
More than 1 odd frequency?
  ├── Yes → return ""
  └── No
       ↓
Build half-frequency
       ↓
Construct smallest left half > target's left half
       ↓
Mirror left half + middle + reverse(left)
       ↓
Answer
```

### 1. Brute Force

```python
class Solution:
    def __init__(self):
        self.result = ""
        self.midChar = '$'
        self.half = 0

    def solve(self, curr, count, target, i, greater):
        if i == self.half:
            left = ''.join(curr)

            candidate = left
            if self.midChar != '$':
                candidate += self.midChar
            candidate += left[::-1]

            if candidate > target:
                self.result = candidate
                return True

            return False

        for ch in range(26):
            if count[ch] == 0:
                continue

            char = chr(ord('a') + ch)

            if not greater and char < target[i]:
                continue

            curr.append(char)
            count[ch] -= 1

            isGreater = greater or char > target[i]

            if self.solve(curr, count, target, i + 1, isGreater):
                return True

            curr.pop()
            count[ch] += 1

        return False

    def lexPalindromicPermutation(self, s: str, target: str) -> str:
        self.result = ""
        self.midChar = '$'

        n = len(s)
        count = [0] * 26

        for ch in s:
            count[ord(ch) - ord('a')] += 1

        oddCount = 0

        for c in range(26):
            if count[c] % 2:
                oddCount += 1
                self.midChar = chr(ord('a') + c)

        if oddCount > 1:
            return ""

        halfCount = [x // 2 for x in count]
        self.half = n // 2

        self.solve([], halfCount, target, 0, False)

        return self.result
```

**TC:** `O(26^(n/2) * n)` worst case
**SC:** `O(n)`

