## Brute Force Code

```python
from collections import Counter

class Solution:
    def smallestPalindrome(self, s: str, k: int) -> str:
        freq = Counter(s)

        half = []
        middle = ""

        for ch in sorted(freq):
            half.extend(ch * (freq[ch] // 2))
            if freq[ch] % 2:
                middle = ch

        half = "".join(half)

        ans = []

        def backtrack(path, used):
            if len(path) == len(half):
                left = "".join(path)
                ans.append(left + middle + left[::-1])
                return

            prev = ""

            for i in range(len(half)):
                if used[i]:
                    continue

                if half[i] == prev:
                    continue

                prev = half[i]
                used[i] = True
                path.append(half[i])

                backtrack(path, used)

                path.pop()
                used[i] = False

        backtrack([], [False] * len(half))

        ans.sort()

        if k > len(ans):
            return ""

        return ans[k - 1]
```

