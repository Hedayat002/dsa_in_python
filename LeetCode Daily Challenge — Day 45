# Optimal Code

```python
from collections import Counter
from math import comb

class Solution:
    def smallestPalindrome(self, s: str, k: int) -> str:
        freq = Counter(s)

        half = [0] * 26
        middle = ""

        for ch, f in freq.items():
            idx = ord(ch) - ord('a')
            half[idx] = f // 2
            if f % 2:
                middle = ch

        def countWays():
            total = sum(half)
            ans = 1

            rem = total

            for x in half:
                if x:
                    ans *= comb(rem, x)
                    rem -= x

                    if ans > k:
                        return ans

            return ans

        if countWays() < k:
            return ""

        left = []

        for _ in range(sum(half)):

            for c in range(26):

                if half[c] == 0:
                    continue

                half[c] -= 1

                cnt = countWays()

                if cnt >= k:
                    left.append(chr(c + ord('a')))
                    break

                k -= cnt
                half[c] += 1

        left = "".join(left)

        return left + middle + left[::-1]
```

