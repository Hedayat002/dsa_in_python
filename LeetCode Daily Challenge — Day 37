# Optimal Code

```python
class Solution:
    def maxActiveSections(self, s: str) -> int:

        n = len(s)

        ones = 0
        max_sum = 0

        prev_run = -1

        i = 0

        while i < n:

            if s[i] == '1':

                ones += 1
                i += 1

            else:

                curr = 0

                while i < n and s[i] == '0':
                    curr += 1
                    i += 1

                if prev_run > 0:
                    max_sum = max(max_sum, prev_run + curr)

                prev_run = curr

        return ones + max_sum
```

