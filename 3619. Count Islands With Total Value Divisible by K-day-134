## 2. Better Solution — BFS

```python
from collections import deque
from typing import List

class Solution:
    def countIslands(self, grid: List[List[int]], k: int) -> int:
        m, n = len(grid), len(grid[0])
        count = 0

        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]

        def bfs(r, c):
            queue = deque([(r, c)])
            total = grid[r][c]
            grid[r][c] = 0

            while queue:
                x, y = queue.popleft()

                for dx, dy in directions:
                    nx, ny = x + dx, y + dy

                    if 0 <= nx < m and 0 <= ny < n and grid[nx][ny] > 0:
                        total += grid[nx][ny]
                        grid[nx][ny] = 0
                        queue.append((nx, ny))

            return total

        for i in range(m):
            for j in range(n):
                if grid[i][j] > 0:
                    total = bfs(i, j)

                    if total % k == 0:
                        count += 1

        return count
```

**Time Complexity:** O(m × n)

**Space Complexity:** O(m × n)

