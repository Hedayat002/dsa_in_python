## Optimal — Segment Tree

```python
class Solution:
    def longestRepeating(self, s: str, queryCharacters: str, queryIndices: list[int]) -> list[int]:
        n = len(s)
        s = list(s)

        tree = [None] * (4 * n)

        def merge(a, b):
            if a is None:
                return b
            if b is None:
                return a

            lc, rc, p, suf, best, length = a
            lc2, rc2, p2, suf2, best2, length2 = b

            new_p = p
            if p == length and rc == lc2:
                new_p += p2

            new_suf = suf2
            if suf2 == length2 and rc == lc2:
                new_suf += suf

            new_best = max(best, best2)

            if rc == lc2:
                new_best = max(new_best, suf + p2)

            return (
                lc,
                rc2,
                new_p,
                new_suf,
                new_best,
                length + length2
            )

        def build(node, lo, hi):
            if lo == hi:
                tree[node] = (s[lo], s[lo], 1, 1, 1, 1)
                return

            mid = (lo + hi) // 2
            build(node * 2, lo, mid)
            build(node * 2 + 1, mid + 1, hi)
            tree[node] = merge(tree[node * 2], tree[node * 2 + 1])

        def update(node, lo, hi, idx):
            if lo == hi:
                tree[node] = (s[idx], s[idx], 1, 1, 1, 1)
                return

            mid = (lo + hi) // 2

            if idx <= mid:
                update(node * 2, lo, mid, idx)
            else:
                update(node * 2 + 1, mid + 1, hi, idx)

            tree[node] = merge(tree[node * 2], tree[node * 2 + 1])

        build(1, 0, n - 1)

        ans = []

        for ch, idx in zip(queryCharacters, queryIndices):
            s[idx] = ch
            update(1, 0, n - 1, idx)
            ans.append(tree[1][4])

        return ans
```

**TC:** `O(N + K log N)`
**SC:** `O(N)`

### Algorithm

```text
Start
  ↓
Build Segment Tree
  ↓
Each node stores:
  left char | right char
  prefix    | suffix
  best      | length
  ↓
For each query:
  Update s[index]
       ↓
  Recalculate path to root
       ↓
  Root.best = longest repeating substring
       ↓
Store answer
  ↓
End
```
