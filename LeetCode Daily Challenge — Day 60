## Better — Segment Tree

```python
class Solution:
    def longestRepeating(self, s: str, queryCharacters: list[str], queryIndices: list[int]) -> list[int]:
        n = len(s)
        s = list(s)

        size = 4 * n
        left_char = [''] * size
        right_char = [''] * size
        prefix = [0] * size
        suffix = [0] * size
        best = [0] * size
        length = [0] * size

        def pull(node):
            l = node * 2
            r = l + 1

            length[node] = length[l] + length[r]
            left_char[node] = left_char[l]
            right_char[node] = right_char[r]

            prefix[node] = prefix[l]
            if prefix[l] == length[l] and right_char[l] == left_char[r]:
                prefix[node] += prefix[r]

            suffix[node] = suffix[r]
            if suffix[r] == length[r] and right_char[l] == left_char[r]:
                suffix[node] += suffix[l]

            best[node] = max(best[l], best[r])

            if right_char[l] == left_char[r]:
                best[node] = max(best[node], suffix[l] + prefix[r])

        def build(node, lo, hi):
            length[node] = hi - lo + 1

            if lo == hi:
                left_char[node] = right_char[node] = s[lo]
                prefix[node] = suffix[node] = best[node] = 1
                return

            mid = (lo + hi) // 2
            build(node * 2, lo, mid)
            build(node * 2 + 1, mid + 1, hi)
            pull(node)

        def update(node, lo, hi, idx):
            if lo == hi:
                left_char[node] = right_char[node] = s[idx]
                prefix[node] = suffix[node] = best[node] = 1
                return

            mid = (lo + hi) // 2

            if idx <= mid:
                update(node * 2, lo, mid, idx)
            else:
                update(node * 2 + 1, mid + 1, hi, idx)

            pull(node)

        build(1, 0, n - 1)

        ans = []

        for ch, idx in zip(queryCharacters, queryIndices):
            s[idx] = ch
            update(1, 0, n - 1, idx)
            ans.append(best[1])

        return ans
```

**TC:** `O(N + K log N)`
**SC:** `O(N)`

