## Optimal Solution

class Solution:
    def maxNumOfSubstrings(self, s: str) -> list[str]:
        n = len(s)

        start = [-1] * 26
        end = [0] * 26
        isValid = [True] * 26

        result = []

        # Step 1: Find first and last occurrence
        for i in range(n):
            idx = ord(s[i]) - ord('a')

            if start[idx] == -1:
                start[idx] = i

            end[idx] = i

        # Step 2: Find valid intervals
        for c in range(26):
            if start[c] == -1:
                continue

            i = start[c]

            while i <= end[c]:
                idx = ord(s[i]) - ord('a')

                if start[idx] < start[c]:
                    isValid[c] = False
                    break

                end[c] = max(end[c], end[idx])

                i += 1

        # Step 3: Select maximum number of non-overlapping intervals
        lastTakenStart = float('inf')

        for i in range(n - 1, -1, -1):
            c = ord(s[i]) - ord('a')

            if not isValid[c]:
                continue

            if i == start[c] and end[c] < lastTakenStart:
                result.append(s[i:end[c] + 1])
                lastTakenStart = i

        # We traversed right -> left,
        # so reverse to get left -> right order.
        result.reverse()

        return result
//T.C : O(n)
//S.C : O(26)
