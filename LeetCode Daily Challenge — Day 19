class Solution:
    def maxPathScore(self, edges, online, k):
        n = len(online)

        graph = [[] for _ in range(n)]
        mx = 0

        for u, v, c in edges:
            graph[u].append((v, c))
            mx = max(mx, c)

        def can(limit):
            best = {}

            def dfs(node, cost):
                if cost > k:
                    return False

                if node == n - 1:
                    return True

                if node in best and best[node] <= cost:
                    return False

                best[node] = cost

                for nxt, w in graph[node]:

                    if w < limit:
                        continue

                    if nxt != n - 1 and not online[nxt]:
                        continue

                    if dfs(nxt, cost + w):
                        return True

                return False

            return dfs(0, 0)

        lo = 0
        hi = mx
        ans = -1

        while lo <= hi:
            mid = (lo + hi) // 2

            if can(mid):
                ans = mid
                lo = mid + 1
            else:
                hi = mid - 1

        return ans


