Code

from collections import deque

class Solution:
    def maxPathScore(self, edges, online, k):
        n = len(online)

        graph = [[] for _ in range(n)]
        indegree = [0] * n
        mx = 0

        for u, v, c in edges:
            graph[u].append((v, c))
            indegree[v] += 1
            mx = max(mx, c)

        q = deque()

        for i in range(n):
            if indegree[i] == 0:
                q.append(i)

        topo = []

        while q:

            node = q.popleft()

            topo.append(node)

            for nxt, _ in graph[node]:

                indegree[nxt] -= 1

                if indegree[nxt] == 0:
                    q.append(nxt)

        INF = float("inf")

        def can(limit):

            dist = [INF] * n

            dist[0] = 0

            for node in topo:

                if dist[node] == INF:
                    continue

                if node != 0 and node != n - 1 and not online[node]:
                    continue

                for nxt, w in graph[node]:

                    if w < limit:
                        continue

                    if nxt != n - 1 and not online[nxt]:
                        continue

                    if dist[node] + w < dist[nxt]:
                        dist[nxt] = dist[node] + w

            return dist[n - 1] <= k

        lo = 0
        hi = mx
        ans = -1

        while lo <= hi:

            mid = (lo + hi) // 2

            if can(mid):
                ans = mid
                lo = mid + 1
            else:
                hi = mid - 1

        return ans


