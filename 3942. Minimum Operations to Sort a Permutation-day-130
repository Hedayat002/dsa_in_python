# 3942. Minimum Operations to Sort a Permutation

## 1. Brute Force Solution — BFS

```python
from collections import deque

class Solution:
    def minOperations(self, nums: list[int]) -> int:
        n = len(nums)
        target = tuple(range(n))
        start = tuple(nums)

        if start == target:
            return 0

        queue = deque([(start, 0)])
        visited = {start}

        while queue:
            arr, steps = queue.popleft()

            left = arr[1:] + arr[:1]
            reverse = arr[::-1]

            for nxt in (left, reverse):
                if nxt == target:
                    return steps + 1

                if nxt not in visited:
                    visited.add(nxt)
                    queue.append((nxt, steps + 1))

        return -1
```

**Time Complexity:** O(n² × n!)  
**Space Complexity:** O(n × n!)

## 2. Better Solution — Enumerate Transformations

```python
class Solution:
    def minOperations(self, nums: list[int]) -> int:
        n = len(nums)
        ans = float("inf")

        for k in range(n):
            if all(nums[(i + k) % n] == i for i in range(n)):
                ans = min(ans, min(k, n - k + 2))

            if all(nums[(n - 1 - i - k) % n] == i for i in range(n)):
                ans = min(ans, min(k, n - k) + 1)

        return ans if ans != float("inf") else -1
```

**Time Complexity:** O(n²)  
**Space Complexity:** O(1)

## 3. Optimal Solution — Linear Time

```python
class Solution:
    def minOperations(self, nums: list[int]) -> int:
        n = len(nums)
        pos = nums.index(0)
        ans = float("inf")

        k = pos
        if all(nums[(i + k) % n] == i for i in range(n)):
            ans = min(ans, min(k, n - k + 2))

        k = (n - 1 - pos) % n
        if all(nums[(n - 1 - i - k) % n] == i for i in range(n)):
            ans = min(ans, min(k, n - k) + 1)

        return ans if ans != float("inf") else -1
```

**Time Complexity:** O(n)  
**Space Complexity:** O(1)

