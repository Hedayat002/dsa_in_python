## Brute Force

```python
class Solution:
    def uniformArray(self, nums1: list[int]) -> bool:
        n = len(nums1)

        # Try making all elements even
        possible_even = True

        for i in range(n):
            if nums1[i] % 2 == 1:
                found = False

                for j in range(n):
                    if i != j and nums1[i] - nums1[j] >= 1:
                        if (nums1[i] - nums1[j]) % 2 == 0:
                            found = True
                            break

                if not found:
                    possible_even = False
                    break

        # Try making all elements odd
        possible_odd = True

        for i in range(n):
            if nums1[i] % 2 == 0:
                found = False

                for j in range(n):
                    if i != j and nums1[i] - nums1[j] >= 1:
                        if (nums1[i] - nums1[j]) % 2 == 1:
                            found = True
                            break

                if not found:
                    possible_odd = False
                    break

        return possible_even or possible_odd
```

**TC:** `O(n²)`
**SC:** `O(1)`

