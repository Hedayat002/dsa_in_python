# 1254. Number of Closed Islands

- **Difficulty:** Medium
- **Topics:** Depth-First Search, Breadth-First Search, Matrix
- **Time Complexity:** O(m × n)
- **Space Complexity:** O(m × n)

## Problem

Given a 2D grid consisting of `0`s (land) and `1`s (water), return the number of closed islands.

A closed island is a group of connected land cells (0s) that is completely surrounded by water (1s) in all four directions.

## 1. Brute Force Solution — DFS

```python
from typing import List

class Solution:
    def dfs(self, grid: List[List[int]], r: int, c: int,
            m: int, n: int) -> bool:

        if r < 0 or r >= m or c < 0 or c >= n:
            return False

        if grid[r][c] == 1:
            return True

        grid[r][c] = 1

        left = self.dfs(grid, r, c - 1, m, n)
        right = self.dfs(grid, r, c + 1, m, n)
        up = self.dfs(grid, r - 1, c, m, n)
        down = self.dfs(grid, r + 1, c, m, n)

        return left and right and up and down

    def closedIsland(self, grid: List[List[int]]) -> int:
        m, n = len(grid), len(grid[0])
        count = 0

        for i in range(m):
            for j in range(n):
                if grid[i][j] == 0:
                    if self.dfs(grid, i, j, m, n):
                        count += 1

        return count
```

- **Time Complexity:** O(m × n)
- **Space Complexity:** O(m × n)

## 2. Better Solution — Boundary DFS

```python
from typing import List

class Solution:
    def dfs(self, grid: List[List[int]], r: int, c: int,
            m: int, n: int) -> None:

        if r < 0 or r >= m or c < 0 or c >= n:
            return

        if grid[r][c] == 1:
            return

        grid[r][c] = 1

        self.dfs(grid, r - 1, c, m, n)
        self.dfs(grid, r + 1, c, m, n)
        self.dfs(grid, r, c - 1, m, n)
        self.dfs(grid, r, c + 1, m, n)

    def closedIsland(self, grid: List[List[int]]) -> int:
        m, n = len(grid), len(grid[0])

        for i in range(m):
            self.dfs(grid, i, 0, m, n)
            self.dfs(grid, i, n - 1, m, n)

        for j in range(n):
            self.dfs(grid, 0, j, m, n)
            self.dfs(grid, m - 1, j, m, n)

        count = 0

        for i in range(1, m - 1):
            for j in range(1, n - 1):
                if grid[i][j] == 0:
                    self.dfs(grid, i, j, m, n)
                    count += 1

        return count
```

- **Time Complexity:** O(m × n)
- **Space Complexity:** O(m × n)

## 3. Optimal Solution — BFS

```python
from typing import List
from collections import deque

class Solution:
    def bfs(self, grid: List[List[int]], r: int, c: int,
            m: int, n: int) -> bool:

        queue = deque([(r, c)])
        grid[r][c] = 1
        closed = True

        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]

        while queue:
            x, y = queue.popleft()

            for dx, dy in directions:
                nx, ny = x + dx, y + dy

                if nx < 0 or nx >= m or ny < 0 or ny >= n:
                    closed = False
                    continue

                if grid[nx][ny] == 0:
                    grid[nx][ny] = 1
                    queue.append((nx, ny))

        return closed

    def closedIsland(self, grid: List[List[int]]) -> int:
        m, n = len(grid), len(grid[0])
        count = 0

        for i in range(m):
            for j in range(n):
                if grid[i][j] == 0:
                    if self.bfs(grid, i, j, m, n):
                        count += 1

        return count
```

- **Time Complexity:** O(m × n)
- **Space Complexity:** O(m × n)
