## 2. Better Solution — KMP Approach

```python
from typing import List


class Solution:
    def computeLPS(self, pattern: List[int], lps: List[int]) -> None:
        m = len(pattern)
        length = 0
        lps[0] = 0
        i = 1

        while i < m:
            if pattern[i] == pattern[length]:
                length += 1
                lps[i] = length
                i += 1
            else:
                if length != 0:
                    length = lps[length - 1]
                else:
                    lps[i] = 0
                    i += 1

    def search(self, pat: List[int], txt: List[int]) -> bool:
        n = len(txt)
        m = len(pat)
        lps = [0] * m

        self.computeLPS(pat, lps)

        i = 0
        j = 0

        while i < n:
            if pat[j] == txt[i]:
                i += 1
                j += 1

            if j == m:
                return True
            elif i < n and pat[j] != txt[i]:
                if j != 0:
                    j = lps[j - 1]
                else:
                    i += 1

        return False

    def isRotation(self, vec1: List[int], vec2: List[int]) -> bool:
        return self.search(vec1, vec2 + vec2)

    def sortableIntegers(self, nums: List[int]) -> int:
        n = len(nums)
        sorted_nums = sorted(nums)
        result = 0

        for k in range(1, n + 1):
            if n % k != 0:
                continue

            valid = True

            for start in range(0, n, k):
                vec1 = nums[start:start + k]
                vec2 = sorted_nums[start:start + k]

                if not self.isRotation(vec1, vec2):
                    valid = False
                    break

            if valid:
                result += k

        return result
```

**Time Complexity:** O(n²) worst case

**Space Complexity:** O(n)

