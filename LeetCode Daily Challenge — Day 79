### Brute Force

```python
from typing import List


class Solution:
    def minMoves(self, classroom: List[str], energy: int) -> int:
        m = len(classroom)
        n = len(classroom[0])

        directions = [(0, 1), (0, -1), (-1, 0), (1, 0)]

        litterBit = [[-1] * n for _ in range(m)]
        litterCount = 0
        sr = sc = 0

        for r in range(m):
            for c in range(n):
                if classroom[r][c] == 'S':
                    sr, sc = r, c
                elif classroom[r][c] == 'L':
                    litterBit[r][c] = litterCount
                    litterCount += 1

        if litterCount == 0:
            return 0

        allCollected = (1 << litterCount) - 1
        visited = set()
        ans = float('inf')

        def dfs(r, c, e, mask, moves):
            nonlocal ans

            if mask == allCollected:
                ans = min(ans, moves)
                return

            if moves >= ans:
                return

            state = (r, c, e, mask)

            if state in visited:
                return

            visited.add(state)

            if e == 0:
                return

            for dr, dc in directions:
                nr, nc = r + dr, c + dc

                if not (0 <= nr < m and 0 <= nc < n):
                    continue

                if classroom[nr][nc] == 'X':
                    continue

                ne = e - 1
                nmask = mask

                if classroom[nr][nc] == 'R':
                    ne = energy
                elif classroom[nr][nc] == 'L':
                    nmask |= 1 << litterBit[nr][nc]

                dfs(nr, nc, ne, nmask, moves + 1)

        dfs(sr, sc, energy, 0, 0)

        return -1 if ans == float('inf') else ans
```

**TC:** `O(m × n × E × 2^k)`

**SC:** `O(m × n × E × 2^k)`

