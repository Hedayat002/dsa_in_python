# Optimal Code

```python
class Solution:
    def minimumPushes(self, word: str) -> int:
        freq = [0] * 26

        # Count frequency of each character
        for ch in word:
            freq[ord(ch) - ord('a')] += 1

        # Highest frequencies first
        freq.sort(reverse=True)

        ans = 0

        # Assign minimum push cost
        for i in range(26):
            ans += freq[i] * ((i // 8) + 1)

        return ans
```

