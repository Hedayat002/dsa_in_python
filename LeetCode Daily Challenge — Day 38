# Optimal Code (Python)

```python
from typing import List
from bisect import bisect_left, bisect_right


class SegmentTree:

    def __init__(self, values):

        self.n = len(values)
        self.tree = [0] * (4 * max(1, self.n))

        if self.n:
            self.build(1, 0, self.n - 1, values)

    def build(self, node, l, r, values):

        if l == r:
            self.tree[node] = values[l]
            return

        mid = (l + r) // 2

        self.build(node * 2, l, mid, values)
        self.build(node * 2 + 1, mid + 1, r, values)

        self.tree[node] = max(
            self.tree[node * 2],
            self.tree[node * 2 + 1]
        )

    def query(self, left, right):

        if left > right or self.n == 0:
            return 0

        return self.solve(
            1,
            0,
            self.n - 1,
            left,
            right
        )

    def solve(self, node, l, r, ql, qr):

        if ql <= l and r <= qr:
            return self.tree[node]

        mid = (l + r) // 2

        ans = 0

        if ql <= mid:
            ans = max(
                ans,
                self.solve(node * 2, l, mid, ql, qr)
            )

        if qr > mid:
            ans = max(
                ans,
                self.solve(node * 2 + 1, mid + 1, r, ql, qr)
            )

        return ans


class Solution:

    def maxActiveSectionsAfterTrade(
        self,
        s: str,
        queries: List[List[int]]
    ) -> List[int]:

        n = len(s)

        totalOnes = s.count('1')

        zeroLength = []
        zeroStart = []
        zeroEnd = []

        i = 0

        while i < n:

            j = i

            while j < n and s[j] == s[i]:
                j += 1

            if s[i] == '0':
                zeroLength.append(j - i)
                zeroStart.append(i)
                zeroEnd.append(j - 1)

            i = j

        m = len(zeroLength)

        if m < 2:
            return [totalOnes] * len(queries)

        gain = []

        for i in range(m - 1):
            gain.append(
                zeroLength[i]
                +
                zeroLength[i + 1]
            )

        seg = SegmentTree(gain)

        ans = []

        for left, right in queries:

            first = bisect_left(zeroEnd, left)

            last = bisect_right(
                zeroStart,
                right
            ) - 1

            if (
                first >= m
                or
                last < 0
                or
                first >= last
            ):
                ans.append(totalOnes)
                continue

            firstLen = (
                zeroEnd[first]
                -
                max(zeroStart[first], left)
                +
                1
            )

            lastLen = (
                min(zeroEnd[last], right)
                -
                zeroStart[last]
                +
                1
            )

            if first + 1 == last:

                best = firstLen + lastLen

            else:

                leftGain = (
                    firstLen
                    +
                    zeroLength[first + 1]
                )

                rightGain = (
                    zeroLength[last - 1]
                    +
                    lastLen
                )

                middleGain = seg.query(
                    first + 1,
                    last - 2
                )

                best = max(
                    leftGain,
                    rightGain,
                    middleGain
                )

            ans.append(
                totalOnes + best
            )

        return ans
```

