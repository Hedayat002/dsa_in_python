## 2. Memoization (Top-Down)

```python
from typing import List
from bisect import bisect_left

class Solution:

    def findMethod(self, nums, start, target):
        n = len(nums)
        j = bisect_left(nums, target, start)

        if j < n and nums[j] == target:
            return j

        return -1

    def solve(self, i, inc, nums, dp):
        if dp[i][inc] != -1:
            return dp[i][inc]

        currVal = nums[i] + inc
        length = 1

        j = self.findMethod(nums, i + 1, currVal + 1)

        if j != -1:
            length = max(
                length,
                1 + self.solve(j, 0, nums, dp)
            )

        j = self.findMethod(nums, i + 1, currVal)

        if j != -1:
            length = max(
                length,
                1 + self.solve(j, 1, nums, dp)
            )

        dp[i][inc] = length
        return dp[i][inc]

    def maxSelectedElements(self, nums: List[int]) -> int:
        nums.sort()
        n = len(nums)

        dp = [[-1] * 2 for _ in range(n)]
        result = 0

        for i in range(n):
            result = max(
                result,
                self.solve(i, 0, nums, dp),
                self.solve(i, 1, nums, dp)
            )

        return result
```

**Time Complexity:** O(n log n)  
**Space Complexity:** O(n)

