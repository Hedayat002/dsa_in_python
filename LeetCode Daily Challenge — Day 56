## 3. Tabulation (Bottom-Up)

```python
class Solution:
    def stoneGameII(self, piles):
        n = len(piles)

        suffix = [0] * (n + 1)
        for i in range(n - 1, -1, -1):
            suffix[i] = piles[i] + suffix[i + 1]

        dp = [[[0] * (n + 1) for _ in range(n + 1)] for _ in range(2)]

        for i in range(n - 1, -1, -1):
            for M in range(1, n + 1):
                limit = min(2 * M, n - i)

                alice = -1
                bob = float('inf')

                for x in range(1, limit + 1):
                    if i + x >= n:
                        alice = max(alice, suffix[i])
                        bob = min(bob, 0)
                    else:
                        alice = max(
                            alice,
                            suffix[i] - dp[0][i + x][max(M, x)]
                        )
                        bob = min(
                            bob,
                            dp[1][i + x][max(M, x)]
                        )

                dp[1][i][M] = alice
                dp[0][i][M] = bob

        return dp[1][0][1]
```

**TC:** `O(n^3)`
**SC:** `O(n^2)`

