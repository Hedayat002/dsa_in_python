## 1. Recursion

```python
class Solution:
    def solve(self, piles, person, i, M, n):
        if i >= n:
            return 0

        result = -1 if person == 1 else float('inf')
        stones = 0

        for x in range(1, min(2 * M, n - i) + 1):
            stones += piles[i + x - 1]

            if person == 1:
                result = max(
                    result,
                    stones + self.solve(
                        piles, 0, i + x, max(M, x), n
                    )
                )
            else:
                result = min(
                    result,
                    self.solve(
                        piles, 1, i + x, max(M, x), n
                    )
                )

        return result

    def stoneGameII(self, piles):
        n = len(piles)
        return self.solve(piles, 1, 0, 1, n)
```

**TC:** `O(2^n)`
**SC:** `O(n)`

