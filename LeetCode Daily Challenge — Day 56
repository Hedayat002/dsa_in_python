## 2. Memoization (Top-Down)

```python
class Solution:
    def solve(self, piles, person, i, M, n, dp):
        if i >= n:
            return 0

        if dp[person][i][M] != -1:
            return dp[person][i][M]

        result = -1 if person == 1 else float('inf')
        stones = 0

        for x in range(1, min(2 * M, n - i) + 1):
            stones += piles[i + x - 1]

            if person == 1:
                result = max(
                    result,
                    stones + self.solve(
                        piles, 0, i + x, max(M, x), n, dp
                    )
                )
            else:
                result = min(
                    result,
                    self.solve(
                        piles, 1, i + x, max(M, x), n, dp
                    )
                )

        dp[person][i][M] = result
        return result

    def stoneGameII(self, piles):
        n = len(piles)
        dp = [[[-1] * (n + 1) for _ in range(n)] for _ in range(2)]
        return self.solve(piles, 1, 0, 1, n, dp)
```

**TC:** `O(n^3)`
**SC:** `O(n^2)`

