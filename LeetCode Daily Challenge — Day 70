optimal solution :
class Solution:
    def sumGame(self, num: str) -> bool:
        ls = 0
        rs = 0
        lb = 0
        rb = 0

        n = len(num)

        # Left half
        for i in range(n // 2):
            if num[i] != '?':
                ls += int(num[i])
            else:
                lb += 1

        # Right half
        for i in range(n // 2, n):
            if num[i] != '?':
                rs += int(num[i])
            else:
                rb += 1

        # Total number of '?' is odd
        if (lb + rb) % 2 == 1:
            return True

        # No '?' remaining
        if lb + rb == 0:
            return ls != rs

        mini = min(lb, rb)

        lb -= mini
        rb -= mini

        if lb > 0:
            if ls > rs:
                return True

            if 9 * (lb // 2) == rs - ls:
                return False
            else:
                return True

        else:
            if rs > ls:
                return True

            if 9 * (rb // 2) == ls - rs:
                return False
            else:
                return True


