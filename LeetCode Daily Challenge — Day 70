class Solution:
    def sumGame(self, num: str) -> bool:
        n = len(num)
        q = [i for i in range(n) if num[i] == '?']

        def dfs(pos, left, right, turn):
            if pos == len(q):
                return left != right

            idx = q[pos]

            if turn == 0:  # Alice: wants unequal
                for d in range(10):
                    if idx < n // 2:
                        if dfs(pos + 1, left + d, right, 1):
                            return True
                    else:
                        if dfs(pos + 1, left, right + d, 1):
                            return True
                return False

            else:  # Bob: wants equal
                for d in range(10):
                    if idx < n // 2:
                        if not dfs(pos + 1, left + d, right, 0):
                            return False
                    else:
                        if not dfs(pos + 1, left, right + d, 0):
                            return False
                return True

        left = right = 0

        for i in range(n // 2):
            if num[i] != '?':
                left += int(num[i])

        for i in range(n // 2, n):
            if num[i] != '?':
                right += int(num[i])

        return dfs(0, left, right, 0)

TC: O(10^q) where q = number of '?'
SC: O(q) recursion stack

