1267. Count Servers That Communicate

Approach	Time Complexity	Auxiliary Space
1. DFS (Iterative)	O(mn(m+n))	O(mn)
2. BFS	O(mn(m+n))	O(mn)
3. Union-Find (DSU)	O(mn α(mn))	O(mn)
4. Row/Column Counting (Optimal)	O(mn)	O(m+n)


1. DFS — Depth-First Search
TC: O(mn(m+n))
SC: O(mn)
from typing import List

class Solution:
    def countServers(self, grid: List[List[int]]) -> int:
        m, n = len(grid), len(grid[0])
        visited = set()
        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]

        def dfs(r, c):
            stack = [(r, c)]
            visited.add((r, c))
            count = 0

            while stack:
                row, col = stack.pop()
                count += 1
                for dr, dc in directions:
                    nr, nc = row + dr, col + dc
                    while 0 <= nr < m and 0 <= nc < n:
                        if grid[nr][nc] == 1 and (nr, nc) not in visited:
                            visited.add((nr, nc))
                            stack.append((nr, nc))
                        nr += dr
                        nc += dc
            return count

        ans = 0
        for r in range(m):
            for c in range(n):
                if grid[r][c] == 1 and (r, c) not in visited:
                    size = dfs(r, c)
                    if size > 1:
                        ans += size
        return ans
2. BFS — Breadth-First Search
TC: O(mn(m+n))
SC: O(mn)
from typing import List
from collections import deque

class Solution:
    def countServers(self, grid: List[List[int]]) -> int:
        m, n = len(grid), len(grid[0])
        visited = set()
        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]

        def bfs(r, c):
            queue = deque([(r, c)])
            visited.add((r, c))
            count = 0

            while queue:
                row, col = queue.popleft()
                count += 1
                for dr, dc in directions:
                    nr, nc = row + dr, col + dc
                    while 0 <= nr < m and 0 <= nc < n:
                        if grid[nr][nc] == 1 and (nr, nc) not in visited:
                            visited.add((nr, nc))
                            queue.append((nr, nc))
                        nr += dr
                        nc += dc
            return count

        ans = 0
        for r in range(m):
            for c in range(n):
                if grid[r][c] == 1 and (r, c) not in visited:
                    size = bfs(r, c)
                    if size > 1:
                        ans += size
        return ans
3. Union-Find — Disjoint Set Union (Your Reusable Template)
TC: O(mn α(mn))
SC: O(mn)
from typing import List

class Solution:
    def find(self, u, parent):
        if parent[u] != u:
            parent[u] = self.find(parent[u], parent)
        return parent[u]

    def union(self, u, v, parent, size):
        pu = self.find(u, parent)
        pv = self.find(v, parent)

        if pu == pv:
            return 0

        paths = size[pu] * size[pv]

        if size[pu] < size[pv]:
            pu, pv = pv, pu

        parent[pv] = pu
        size[pu] += size[pv]
        return paths

    def countServers(self, grid: List[List[int]]) -> int:
        m, n = len(grid), len(grid[0])
        parent = list(range(m * n))
        size = [1] * (m * n)
        first_row = {}
        first_col = {}
        servers = []

        for r in range(m):
            for c in range(n):
                if grid[r][c] == 1:
                    idx = r * n + c
                    servers.append(idx)

                    if r in first_row:
                        self.union(idx, first_row[r], parent, size)
                    else:
                        first_row[r] = idx

                    if c in first_col:
                        self.union(idx, first_col[c], parent, size)
                    else:
                        first_col[c] = idx

        ans = 0
        for idx in servers:
            root = self.find(idx, parent)
            if size[root] > 1:
                ans += 1
        return ans
paths = size[pu] * size[pv] is preserved from the reusable DSU template. It counts newly connected pairs, not communicating servers, so its returned value is not added to the answer.

4. Optimized — Row & Column Counting
TC: O(mn)
SC: O(m+n)
from typing import List

class Solution:
    def countServers(self, grid: List[List[int]]) -> int:
        m, n = len(grid), len(grid[0])
        row_count = [0] * m
        col_count = [0] * n

        for r in range(m):
            for c in range(n):
                if grid[r][c] == 1:
                    row_count[r] += 1
                    col_count[c] += 1

        communicating_servers = 0
        for r in range(m):
            for c in range(n):
                if grid[r][c] == 1:
                    if row_count[r] > 1 or col_count[c] > 1:
                        communicating_servers += 1

        return communicating_servers
