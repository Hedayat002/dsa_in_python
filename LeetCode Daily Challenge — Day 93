1. Recurssion 
class Solution:
    def isPalindrome(self, s, left, right):
        while left < right:
            if s[left] != s[right]:
                return False
            left += 1
            right -= 1
        return True

    def solve(self, s, k, i):
        n = len(s)

        if i >= n:
            return 0

        ans = self.solve(s, k, i + 1)

        for j in range(i + k - 1, n):
            if self.isPalindrome(s, i, j):
                ans = max(ans, 1 + self.solve(s, k, j + 1))

        return ans
    def maxPalindromes(self, s: str, k: int) -> int:
        return self.solve(s, k, 0)


TC: O(2^n * n)
SC: O(n)

2. Memoization (Top-Down)
class Solution:
    def isPalindrome(self, s, left, right):
        while left < right:
            if s[left] != s[right]:
                return False
            left += 1
            right -= 1
        return True

    def solve(self, s, k, i,dp):
        n = len(s)

        if i >= n:
            return 0

        if dp[i] != -1:
            return dp[i]

        ans = self.solve(s, k, i + 1,dp)

        for j in range(i + k - 1, n):
            if self.isPalindrome(s, i, j):
                ans = max(ans, 1 + self.solve(s, k, j + 1,dp))
        
        dp[i] = ans

        return dp[i]
    def maxPalindromes(self, s: str, k: int) -> int:
        n = len(s)

        dp = [-1] * n
        return self.solve(s, k, 0,dp)

TC: O(n^3)
SC: O(n) +O(n)
3. Tabulation (Bottom-Up)
class Solution:
    def maxPalindromes(self, s: str, k: int) -> int:
        n = len(s)

        pal = [[False] * n for _ in range(n)]

        for i in range(n - 1, -1, -1):
            for j in range(i, n):
                if s[i] == s[j] and (j - i <= 2 or pal[i + 1][j - 1]):
                    pal[i][j] = True

        dp = [0] * (n + 1)

        for i in range(n - 1, -1, -1):
            dp[i] = dp[i + 1]

            for j in range(i + k - 1, n):
                if pal[i][j]:
                    dp[i] = max(dp[i], 1 + dp[j + 1])

        return dp[0]


