## 2. Memoization (Top-Down)

```python
class Solution:
    def left_height(self, arr, i, dp):
        if i == 0:
            return min(arr[i], 1)

        if dp[i] != -1:
            return dp[i]

        dp[i] = min(arr[i], self.left_height(arr, i - 1, dp) + 1)
        return dp[i]

    def right_height(self, arr, i, dp):
        if i == len(arr) - 1:
            return min(arr[i], 1)

        if dp[i] != -1:
            return dp[i]

        dp[i] = min(arr[i], self.right_height(arr, i + 1, dp) + 1)
        return dp[i]

    def maxSum(self, arr):
        n = len(arr)
        left = [-1] * n
        right = [-1] * n

        for i in range(n):
            self.left_height(arr, i, left)

        for i in range(n):
            self.right_height(arr, i, right)

        total = sum(arr)
        best = 0

        for i in range(n):
            h = min(left[i], right[i])
            best = max(best, h * h)

        return total - best
```

**TC:** O(n)
**SC:** O(n)

