# 3946. Maximum Number of Items From Sale I

## 1. Recursion

```python
from typing import List

class Solution:
    def solve(self, n, items, budget, copies, cheapestprice):
        if n == 0:
            return budget // cheapestprice

        take = 0
        price = items[n - 1][1]

        if price <= budget:
            take = 1 + copies[n - 1] + self.solve(
                n - 1, items, budget - price, copies, cheapestprice
            )

        skip = self.solve(
            n - 1, items, budget, copies, cheapestprice
        )

        return max(skip, take)

    def maximumSaleItems(self, items: List[List[int]], budget: int) -> int:
        n = len(items)
        cheapestprice = min(price for factor, price in items)
        copies = [0] * n

        for i in range(n):
            for j in range(n):
                if i != j and items[j][0] % items[i][0] == 0:
                    copies[i] += 1

        return self.solve(n, items, budget, copies, cheapestprice)
```

**TC:** O(n² + 2ⁿ)  
**SC:** O(n)

