## 2. Memoization (Top-Down)

```python
from typing import List
import sys

class Solution:
    def solve(self, n, items, budget, copies, cheapestprice, dp):
        if n == 0:
            return budget // cheapestprice

        if dp[n][budget] != -1:
            return dp[n][budget]

        take = 0
        price = items[n - 1][1]

        if price <= budget:
            take = 1 + copies[n - 1] + self.solve(
                n - 1, items, budget - price, copies, cheapestprice, dp
            )

        skip = self.solve(
            n - 1, items, budget, copies, cheapestprice, dp
        )

        dp[n][budget] = max(skip, take)

        return dp[n][budget]

    def maximumSaleItems(self, items: List[List[int]], budget: int) -> int:
        sys.setrecursionlimit(10000)

        n = len(items)
        cheapestprice = min(price for factor, price in items)
        copies = [0] * n

        for i in range(n):
            for j in range(n):
                if i != j and items[j][0] % items[i][0] == 0:
                    copies[i] += 1

        dp = [[-1] * (budget + 1) for _ in range(n + 1)]

        return self.solve(n, items, budget, copies, cheapestprice, dp)
```

**TC:** O(n² + n × budget)  
**SC:** O(n × budget) + O(n)

