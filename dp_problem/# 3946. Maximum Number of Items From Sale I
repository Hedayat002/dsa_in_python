## 3. Tabulation (Bottom-Up)

```python
from typing import List

class Solution:
    def maximumSaleItems(self, items: List[List[int]], budget: int) -> int:
        n = len(items)
        cheapestprice = min(price for factor, price in items)
        copies = [0] * n

        for i in range(n):
            for j in range(n):
                if i != j and items[j][0] % items[i][0] == 0:
                    copies[i] += 1

        dp = [[0] * (budget + 1) for _ in range(n + 1)]

        for b in range(budget + 1):
            dp[0][b] = b // cheapestprice

        for i in range(1, n + 1):
            price = items[i - 1][1]

            for b in range(budget + 1):
                take = 0

                if price <= b:
                    take = 1 + copies[i - 1] + dp[i - 1][b - price]

                skip = dp[i - 1][b]

                dp[i][b] = max(skip, take)

        return dp[n][budget]
```

**TC:** O(n² + n × budget)  
**SC:** O(n × budget)

