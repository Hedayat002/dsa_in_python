
# 3693. Climbing Stairs II

## 1. Recursion

```python
from typing import List

class Solution:
    def solve(self, i, n, costs):
        if i == n:
            return 0

        if i > n:
            return float('inf')

        one = self.solve(i + 1, n, costs) + costs[i] + 1

        two = float('inf')
        if i + 2 <= n:
            two = self.solve(i + 2, n, costs) + costs[i + 1] + 4

        three = float('inf')
        if i + 3 <= n:
            three = self.solve(i + 3, n, costs) + costs[i + 2] + 9

        return min(one, two, three)

    def climbStairs(self, n: int, costs: List[int]) -> int:
        return self.solve(0, n, costs)
```

- **TC:** O(3^n)
- **SC:** O(n)

## 2. Memoization (Top-Down)

```python
from typing import List

class Solution:
    def solve(self, i, n, costs, dp):
        if i == n:
            return 0

        if dp[i] != -1:
            return dp[i]

        one = self.solve(i + 1, n, costs, dp) + costs[i] + 1

        two = float('inf')
        if i + 2 <= n:
            two = self.solve(i + 2, n, costs, dp) + costs[i + 1] + 4

        three = float('inf')
        if i + 3 <= n:
            three = self.solve(i + 3, n, costs, dp) + costs[i + 2] + 9

        dp[i] = min(one, two, three)
        return dp[i]

    def climbStairs(self, n: int, costs: List[int]) -> int:
        dp = [-1] * (n + 1)
        return self.solve(0, n, costs, dp)
```

- **TC:** O(n)
- **SC:** O(n)

## 3. Tabulation (Bottom-Up)

```python
from typing import List

class Solution:
    def climbStairs(self, n: int, costs: List[int]) -> int:
        dp = [0] * (n + 1)

        for i in range(1, n + 1):
            one = dp[i - 1] + costs[i - 1] + 1

            two = float('inf')
            if i >= 2:
                two = dp[i - 2] + costs[i - 1] + 4

            three = float('inf')
            if i >= 3:
                three = dp[i - 3] + costs[i - 1] + 9

            dp[i] = min(one, two, three)

        return dp[n]
```

- **TC:** O(n)
- **SC:** O(n)

## 4. Space Optimization

```python
from typing import List

class Solution:
    def climbStairs(self, n: int, costs: List[int]) -> int:
        prev1 = prev2 = prev3 = 0

        for i in range(1, n + 1):
            one = prev1 + costs[i - 1] + 1

            two = float('inf')
            if i >= 2:
                two = prev2 + costs[i - 1] + 4

            three = float('inf')
            if i >= 3:
                three = prev3 + costs[i - 1] + 9

            curr = min(one, two, three)

            prev3 = prev2
            prev2 = prev1
            prev1 = curr

        return prev1
```

- **TC:** O(n)
- **SC:** O(1)
