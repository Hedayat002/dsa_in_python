Problem : 1872. Stone Game VIII
Platform : Leetcode 

1. Recursion
class Solution:
    def solve(self, i, prefixsum):
        if i == len(prefixsum) - 1:
            return prefixsum[i]

        take = prefixsum[i] - self.solve(i + 1, prefixsum)
        skip = self.solve(i + 1, prefixsum)

        return max(take, skip)

    def stoneGameVIII(self, stones):
        n = len(stones)

        prefixsum = [0] * n
        prefixsum[0] = stones[0]

        for i in range(1, n):
            prefixsum[i] = prefixsum[i - 1] + stones[i]

        return self.solve(1, prefixsum)

TC: O(2^n)
SC: O(n)

2. Memoization (Top-Down):
class Solution:
    def solve(self,i,prefixsum,dp ):
        if i == len(prefixsum) - 1:
            return prefixsum[i]

        if dp[i] != -1:
            return dp[i] 


        take = prefixsum[i] - self.solve(i + 1, prefixsum,dp)
        skip = self.solve(i + 1, prefixsum,dp)

        dp[i] = max(take, skip)

        return dp[i]
    def stoneGameVIII(self, stones: List[int]) -> int:
        n = len(stones)

        prefixsum = [0] * n
        prefixsum[0] = stones[0]

        for i in range(1, n):
            prefixsum[i] = prefixsum[i - 1] + stones[i]

        dp = [-1] *n

        return self.solve(1, prefixsum,dp )

TC: O(n)
SC: O(n) + O(n)

3. Tabulation (Bottom-Up)

class Solution:
    def solve(self,i,prefixsum,dp ):
        if i == len(prefixsum) - 1:
            return prefixsum[i]

        if dp[i] != -1:
            return dp[i] 


        take = prefixsum[i] - self.solve(i + 1, prefixsum,dp)
        skip = self.solve(i + 1, prefixsum,dp)

        dp[i] = max(take, skip)

        return dp[i]
    def stoneGameVIII(self, stones: List[int]) -> int:
        n = len(stones)

        prefixsum = [0] * n
        prefixsum[0] = stones[0]

        for i in range(1, n):
            prefixsum[i] = prefixsum[i - 1] + stones[i]

        dp = [0] *n
        dp[n - 1] = prefixsum[n - 1]

        for i in range(n - 2, 0, -1):
            
            take = prefixsum[i] - dp[i+1]
            skip = dp[i+1]

            dp[i] = max(take, skip)

        return dp[1]
TC: O(n)
SC: O(n) 

4. Space Optimization
class Solution:
    def stoneGameVIII(self, stones: List[int]) -> int:
        n = len(stones)

        prefixsum = [0] * n
        prefixsum[0] = stones[0]

        for i in range(1, n):
            prefixsum[i] = prefixsum[i - 1] + stones[i]

        prev = prefixsum[n - 1]

        for i in range(n - 2, 0, -1):
            curr = max(prefixsum[i] - prev, prev)
            prev = curr

        return prev
TC: O(n)
SC: O(n)
