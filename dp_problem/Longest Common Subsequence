Problem: Longest Common Subsequence
Platform: GFG

## 1. Recursion

```python
class Solution:
    def solve(self, ind1, ind2, s1, s2):
        if ind1 < 0 or ind2 < 0:
            return 0

        if s1[ind1] == s2[ind2]:
            return 1 + self.solve(ind1 - 1, ind2 - 1, s1, s2)

        return max(
            self.solve(ind1 - 1, ind2, s1, s2),
            self.solve(ind1, ind2 - 1, s1, s2)
        )

    def longestCommonSubsequence(self, s1, s2):
        return self.solve(len(s1) - 1, len(s2) - 1, s1, s2)
```

**TC:** O(2^(n+m))
**SC:** O(n+m)

---

## 2. Memoization (Top-Down)

```python
class Solution:
    def solve(self, ind1, ind2, s1, s2, dp):
        if ind1 < 0 or ind2 < 0:
            return 0

        if dp[ind1][ind2] != -1:
            return dp[ind1][ind2]

        if s1[ind1] == s2[ind2]:
            dp[ind1][ind2] = 1 + self.solve(
                ind1 - 1, ind2 - 1, s1, s2, dp
            )
        else:
            dp[ind1][ind2] = max(
                self.solve(ind1 - 1, ind2, s1, s2, dp),
                self.solve(ind1, ind2 - 1, s1, s2, dp)
            )

        return dp[ind1][ind2]

    def longestCommonSubsequence(self, s1, s2):
        n = len(s1)
        m = len(s2)

        dp = [[-1] * m for _ in range(n)]

        return self.solve(n - 1, m - 1, s1, s2, dp)
```

**TC:** O(n × m)
**SC:** O(n × m) + O(n+m)

