Problem : 1563. Stone Game V
Platform : Leetcode 



1.Recurssion solution 
class Solution:
    def solve(self,l,r):
        if l == r:
            return 0

        score = 0
        for mid in range(l,r):
            leftsum = self.prefixsum[mid+1] - self.prefixsum[l]
            rightsum = self.prefixsum[r+1] - self.prefixsum[mid+1]

            if leftsum < rightsum :
                score = max(score, leftsum + self.solve(l,mid))

            elif leftsum > rightsum :
                score = max(score, rightsum + self.solve(mid+1,r))

            else:

                score = max(score,leftsum + self.solve(l, mid),
                    rightsum + self.solve(mid + 1, r)
                )
        return score


    def stoneGameV(self, stoneValue: List[int]) -> int:
        n = len(stoneValue)
        self.prefixsum = [0] * (n + 1)

        for i in range(n):
            self.prefixsum[i + 1] = self.prefixsum[i] + stoneValue[i]
        return self.solve(0,n-1,)


TC: O(3^n)
SC: O(n)

2. Memoization (Top-Down)

class Solution:
    def solve(self,l,r, dp):
        if l == r:
            return 0

        score = 0
        if dp[l][r] != -1:
            return dp[l][r]

            
        for mid in range(l,r):
            leftsum = self.prefixsum[mid+1] - self.prefixsum[l]
            rightsum = self.prefixsum[r+1] - self.prefixsum[mid+1]

            if leftsum < rightsum :
                score = max(score, leftsum + self.solve(l,mid,dp))

            elif leftsum > rightsum :
                score = max(score, rightsum + self.solve(mid+1,r,dp))

            else:

                score = max(score,leftsum + self.solve(l, mid,dp),
                    rightsum + self.solve(mid + 1, r,dp)
                )
        dp[l][r] = score
        return dp[l][r]


    def stoneGameV(self, stoneValue: List[int]) -> int:
        n = len(stoneValue)
        self.prefixsum = [0] * (n + 1)

        for i in range(n):
            self.prefixsum[i + 1] = self.prefixsum[i] + stoneValue[i]

        dp = [[-1] * n for _ in range(n)]
        return self.solve(0,n-1,dp)

TC: O(n^3)
SC: O(n^2)


