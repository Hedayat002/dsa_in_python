1. Recursion

Idea: Treat the forward and return trips as two people moving simultaneously from (0,0) to (n-1,n-1). Since both have taken the same number of steps, c2 = r1 + c1 - r2.

class Solution:
    def solve(self, r1, c1, r2, grid):
        n = len(grid)
        c2 = r1 + c1 - r2

        # Out of bounds
        if r1 >= n or c1 >= n or r2 >= n or c2 >= n:
            return float('-inf')

        # Negative column
        if c2 < 0:
            return float('-inf')

        # Thorn
        if grid[r1][c1] == -1 or grid[r2][c2] == -1:
            return float('-inf')

        # Destination
        if r1 == n - 1 and c1 == n - 1:
            return grid[r1][c1]

        # Collect cherries
        if r1 == r2 and c1 == c2:
            cherries = grid[r1][c1]
        else:
            cherries = grid[r1][c1] + grid[r2][c2]

        # Four possible combinations
        best = max(
            self.solve(r1 + 1, c1, r2 + 1, grid),  # down, down
            self.solve(r1 + 1, c1, r2, grid),      # down, right
            self.solve(r1, c1 + 1, r2 + 1, grid),  # right, down
            self.solve(r1, c1 + 1, r2, grid)       # right, right
        )

        return cherries + best

    def cherryPickup(self, grid):
        ans = self.solve(0, 0, 0, grid)
        return max(0, ans)

TC: O(4^(2n))
SC: O(n) recursion stack
