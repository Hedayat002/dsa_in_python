### 3. Tabulation — Bottom Up

**Idea:** `dp[r1][c1][r2]` stores the maximum cherries when the two travelers are at `(r1,c1)` and `(r2,c2)`.

```python
class Solution:
    def cherryPickup(self, grid):
        n = len(grid)
        NEG = float('-inf')

        dp = [[[NEG] * n for _ in range(n)] for _ in range(n)]
        dp[0][0][0] = grid[0][0]

        for r1 in range(n):
            for c1 in range(n):
                for r2 in range(n):
                    c2 = r1 + c1 - r2

                    if c2 < 0 or c2 >= n:
                        continue

                    if grid[r1][c1] == -1 or grid[r2][c2] == -1:
                        continue

                    if r1 == 0 and c1 == 0 and r2 == 0:
                        continue

                    best = NEG

                    # Previous states
                    if r1 > 0 and r2 > 0:
                        best = max(best, dp[r1 - 1][c1][r2 - 1])

                    if r1 > 0 and c2 > 0:
                        best = max(best, dp[r1 - 1][c1][r2])

                    if c1 > 0 and r2 > 0:
                        best = max(best, dp[r1][c1 - 1][r2 - 1])

                    if c1 > 0 and c2 > 0:
                        best = max(best, dp[r1][c1 - 1][r2])

                    if best == NEG:
                        continue

                    cherries = grid[r1][c1]

                    if r1 != r2 or c1 != c2:
                        cherries += grid[r2][c2]

                    dp[r1][c1][r2] = best + cherries

        return max(0, dp[n - 1][n - 1][n - 1])
```

**TC:** `O(n³)`
**SC:** `O(n³)`

