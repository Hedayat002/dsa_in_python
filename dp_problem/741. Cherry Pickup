### 2. Memoization — Top Down

**Idea:** Many `(r1, c1, r2)` states repeat. Store the result of each state.

```python
class Solution:
    def cherryPickup(self, grid):
        n = len(grid)
        memo = {}

        def solve(r1, c1, r2):
            c2 = r1 + c1 - r2

            if r1 >= n or c1 >= n or r2 >= n or c2 >= n or c2 < 0:
                return float('-inf')

            if grid[r1][c1] == -1 or grid[r2][c2] == -1:
                return float('-inf')

            if (r1, c1, r2) in memo:
                return memo[(r1, c1, r2)]

            if r1 == n - 1 and c1 == n - 1:
                return grid[r1][c1]

            if r1 == r2 and c1 == c2:
                cherries = grid[r1][c1]
            else:
                cherries = grid[r1][c1] + grid[r2][c2]

            best = max(
                solve(r1 + 1, c1, r2 + 1),
                solve(r1 + 1, c1, r2),
                solve(r1, c1 + 1, r2 + 1),
                solve(r1, c1 + 1, r2)
            )

            memo[(r1, c1, r2)] = cherries + best
            return memo[(r1, c1, r2)]

        return max(0, solve(0, 0, 0))
```

**TC:** `O(n³)`
**SC:** `O(n³)` + `O(n)` recursion stack → `O(n³)`

