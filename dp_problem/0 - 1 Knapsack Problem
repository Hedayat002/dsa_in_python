Problem: 0 - 1 Knapsack Problem
Platform: GFG

1.Recurssion 

class Solution:
    def solve(self,index,w,val,wt):
        if index ==0:
            if wt[index] <=w:
                return val[index]
            return 0
            
        if wt[index] >w:
            pick = float("-inf")
        else:
            pick = val[index]+ self.solve(index-1,w-wt[index],val,wt)
        not_pick = 0+ self.solve(index-1,w,val,wt)
        
        return max(pick,not_pick)
    def knapsack(self, W: int, val: list[int], wt: list[int]) -> int:
        # code here
        n = len(wt)
        return self.solve(n-1,W,val,wt)
TC: O(2ⁿ)
SC: O(n)

2. Memoization (Top-Down)

class Solution:
    def solve(self,index,w,val,wt,dp):
        if index ==0:
            if wt[index] <=w:
                return val[index]
            return 0
        
        if dp[index][w] != -1:
            return dp[index][w]
            
            
        if wt[index] >w:
            pick = float("-inf")
        else:
            pick = val[index]+ self.solve(index-1,w-wt[index],val,wt,dp)
        not_pick = 0+ self.solve(index-1,w,val,wt,dp)
        
        dp[index][w] = max(pick,not_pick)
    
        
        return dp[index][w]
    def knapsack(self, W: int, val: list[int], wt: list[int]) -> int:
        # code here
        n = len(wt)
        dp = [[-1] * (W + 1) for _ in range(n)]
        return self.solve(n-1,W,val,wt,dp)
  TC: O(n × W)
SC: O(n × W) + O(n)

3. Tabulation (Bottom-Up)
class Solution:
    def knapsack(self, W: int, val: list[int], wt: list[int]) -> int:
        # code here
        n = len(wt)
        dp = [[0] * (W + 1) for _ in range(n)]
        
        for w in range(0, W + 1):
            if wt[0] <=w:
                
                 dp[0][w] = val[0]
            
        for index in range(1, n):
            for w in range(W + 1):
                if wt[index] >w:
                    pick = float("-inf")
                else:
                    pick = val[index]+ dp[index - 1][w - wt[index]]
                not_pick = 0+ dp[index - 1][w]
                
                dp[index][w] = max(pick,not_pick)
        return dp[n - 1][W]

TC: O(n × W)
SC: O(n × W)

4. Space Optimization
class Solution:
    def knapsack(self, W: int, val: list[int], wt: list[int]) -> int:
        # code here
        n = len(wt)
        prev = [0] * (W + 1)
        
        for w in range(0, W + 1):
            if wt[0] <=w:
                
                 prev[w] = val[0]
            
        for index in range(1, n):
            curr = [0] * (W + 1)
            for w in range(W + 1):
                if wt[index] >w:
                    pick = float("-inf")
                else:
                    pick = val[index]+ prev[w - wt[index]]
                not_pick = 0+ prev[w]
                
                curr[w] = max(pick,not_pick)
            prev = curr
        return prev[W]
TC: O(n × W)
SC: O(2W)

