problem : Rod Cutting
Platform : GFG

1. Recursion
class Solution:
    def solve(self, i, price):

        if i == 0:
            return 0
    
        ans = 0
    
        for cut in range(1, i + 1):
            ans = max(
                ans,
                price[cut - 1] + self.solve(i - cut, price)
            )
    
        return ans
    def cutRod(self, price: list[int]) -> int:
        # code here
        n = len(price)
        return self.solve(n, price)

TC: O(2ⁿ)
SC: O(n)

2. Memoization (Top-Down)

class Solution:
    def solve(self, i, price,dp):

        if i == 0:
            return 0
    
        ans = 0
        if dp[i] != -1:
            return dp[i]
    
        for cut in range(1, i + 1):
            ans = max(
                ans,
                price[cut - 1] + self.solve(i - cut, price,dp)
            )
    
        dp[i] = ans
        return ans
    def cutRod(self, price: list[int]) -> int:
        # code here
        n = len(price)
        dp = [-1]*(n+1)
        return self.solve(n, price,dp )
TC: O(n²)
SC: O(n)


3. Tabulation (Bottom-Up)
class Solution:
    def cutRod(self, price: list[int]) -> int:
        # code here
        n = len(price)
        dp = [0]*(n+1)
        dp[0] = 0
        for i in range(1, n + 1):
            for cut in range(1, i + 1):
                dp[i] = max(dp[i],price[cut - 1] + dp[i - cut]
                )
                
        return dp[n]
TC: O(n²)
SC: O(n)
    
