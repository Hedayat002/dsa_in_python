Problem: Longest Common Substring
Platform: GFG

1. Recursion — Bottom indices
class Solution:
    def solve(self, s1, s2, i, j, count):
        if i < 0 or j < 0:
           return count

    
        if s1[i] == s2[j]:
            count = self.solve(s1, s2, i - 1, j - 1, count + 1)
    
        skip_s1 = self.solve(s1, s2, i - 1, j, 0)
        skip_s2 = self.solve(s1, s2, i, j - 1, 0)
    
        return max(count, skip_s1, skip_s2)
    def longCommSubstr(self, s1, s2):
        # code here
        n = len(s1)
        m = len(s2)
        return self.solve(s1, s2, n-1, m-1, 0)

Time  : O(2^(n+m)) approximately
Space : O(n+m) recursion stack

2. Memoization — Top Down
class Solution:
    def solve(self, s1, s2, i, j, count, dp):
        if i < 0 or j < 0:
            return count

        if dp[i][j][count] != -1:
            return dp[i][j][count]

        current = count

        if s1[i] == s2[j]:
            current = self.solve(
                s1, s2, i - 1, j - 1, count + 1, dp
            )

        skip_s1 = self.solve(s1, s2, i - 1, j, 0, dp)
        skip_s2 = self.solve(s1, s2, i, j - 1, 0, dp)

        dp[i][j][count] = max(current, skip_s1, skip_s2)

        return dp[i][j][count]

    def longCommSubstr(self, s1, s2):
        n = len(s1)
        m = len(s2)

        dp = [
            [[-1] * (min(n, m) + 1) for _ in range(m)]
            for _ in range(n)
        ]

        return self.solve(s1, s2, n - 1, m - 1, 0, dp)

TC: O(n × m × min(n,m))
SC: O(n × m × min(n,m)) + O(n+m)

3. Tabulation — Bottom-Up

class Solution:
    def longCommSubstr(self, s1, s2):
        # code here
        n, m = len(s1), len(s2)

        dp = [[0] * (m + 1) for _ in range(n + 1)]

        ans = 0

        for i in range(1, n + 1):
            for j in range(1, m + 1):

                if s1[i - 1] == s2[j - 1]:
                    dp[i][j] = dp[i - 1][j - 1] + 1

                    ans = max(ans, dp[i][j])

        return ans

TC: O(n × m)
SC: O(n × m)
4. Space Optimization

class Solution:
    def longCommSubstr(self, s1, s2):
        # code here
        n, m = len(s1), len(s2)

        prev = [0] * (m + 1)

        ans = 0

        for i in range(1, n + 1):
            curr = [0] * (m + 1)
            for j in range(1, m + 1):

                if s1[i - 1] == s2[j - 1]:
                    curr[j] = prev[j - 1] + 1

                    ans = max(ans, curr[j])
                    
            prev = curr

        return ans

TC: O(n × m)
SC: O(m)
