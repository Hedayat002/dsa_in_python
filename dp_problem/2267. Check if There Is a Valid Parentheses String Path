
1. Recursion
class Solution:
    def solve(self, i, j, grid, balance):
        if grid[i][j] == ')':
            balance += 1
        else:
            balance -= 1

        if balance < 0:
            return False

        if i == 0 and j == 0:
            return balance == 0

        up = False
        if i > 0:
            up = self.solve(i - 1, j, grid, balance)

        left = False
        if j > 0:
            left = self.solve(i, j - 1, grid, balance)

        return up or left

    def hasValidPath(self, grid: list[list[str]]) -> bool:
        n = len(grid)
        m = len(grid[0])

        if grid[0][0] == ')' or grid[n - 1][m - 1] == '(':
            return False

        return self.solve(n - 1, m - 1, grid, 0)

TC: O(2^(m+n))
SC: O(m+n)

2. Memoization (Top-Down)
class Solution:
    def solve(self, i, j, grid, balance, dp):
        if grid[i][j] == ')':
            balance += 1
        else:
            balance -= 1

        if balance < 0:
            return False

        if i == 0 and j == 0:
            return balance == 0

        if dp[i][j][balance] != -1:
            return dp[i][j][balance]

        up = False
        if i > 0:
            up = self.solve(i - 1, j, grid, balance, dp)

        left = False
        if j > 0:
            left = self.solve(i, j - 1, grid, balance, dp)

        dp[i][j][balance] = up or left
        return dp[i][j][balance]

    def hasValidPath(self, grid: list[list[str]]) -> bool:
        n = len(grid)
        m = len(grid[0])

        if grid[0][0] == ')' or grid[n - 1][m - 1] == '(':
            return False

        dp = [[[-1] * (n + m) for _ in range(m)] for _ in range(n)]

        return self.solve(n - 1, m - 1, grid, 0, dp)

TC: O(m × n × (m+n))
SC: O(m × n × (m+n))

3. Tabulation (Bottom-Up)
class Solution:
    def hasValidPath(self, grid: list[list[str]]) -> bool:
        n = len(grid)
        m = len(grid[0])
        if grid[0][0] == ')' or grid[n - 1][m - 1] == '(':
            return False
        dp = [[[False] * (n + m) for _ in range(m)] for _ in range(n)]
        dp[0][0][1] = True

        for i in range(n):
            for j in range(m):
                if i == 0 and j == 0:
                    continue
                for balance in range(n + m):
                    if grid[i][j] == '(':
                        if balance == 0:
                            continue

                        up = False
                        if i > 0:
                            up = dp[i - 1][j][balance - 1]

                        left = False
                        if j > 0:
                            left = dp[i][j - 1][balance - 1]

                    else:
                        if balance == n + m - 1:
                            continue

                        up = False
                        if i > 0:
                            up = dp[i - 1][j][balance + 1]

                        left = False
                        if j > 0:
                            left = dp[i][j - 1][balance + 1]

                    dp[i][j][balance] = up or left

        return dp[n - 1][m - 1][0]

TC: O(m × n × (m+n))
SC: O(m × n × (m+n))

4. Tabulation (Space Optimization)

class Solution:
    def hasValidPath(self, grid: list[list[str]]) -> bool:
        n = len(grid)
        m = len(grid[0])
        if grid[0][0] == ')' or grid[n - 1][m - 1] == '(':
            return False
        prev = [[False] * (n + m) for _ in range(m)] 
        prev[0][1] = True

        for i in range(n):
            curr = [[False] * (n + m) for _ in range(m)]
            for j in range(m):
                if i == 0 and j == 0:
                    curr[j][1] = True
                    continue
                for balance in range(n + m):
                    if grid[i][j] == '(':
                        if balance == 0:
                            continue

                        up = False
                        if i > 0:
                            up = prev[j][balance - 1]

                        left = False
                        if j > 0:
                            left = curr[j - 1][balance - 1]

                    else:
                        if balance == n + m - 1:
                            continue

                        up = False
                        if i > 0:
                            up = prev[j][balance + 1]

                        left = False
                        if j > 0:
                            left = curr[j - 1][balance + 1]

                    curr[j][balance] = up or left
            prev = curr

        return prev[m - 1][0]
TC: O(n × m × (n + m))
SC: O(m × (n + m))
