# 4. Space Optimization

class Solution:
    def solve(self, nums):
        n = len(nums)

        prev = nums[0]
        prev2 = 0

        for index in range(1, n):
            pick = nums[index]
            if index > 1:
                pick += prev2

            not_pick = prev
            curr = max(pick, not_pick)

            prev2 = prev
            prev = curr

        return prev

    def rob(self, nums: List[int]) -> int:
        n = len(nums)

        if n == 1:
            return nums[0]

        ans1 = self.solve(nums[:-1])
        ans2 = self.solve(nums[1:])

        return max(ans1, ans2)
```

**Time Complexity:** `O(N)`
**Space Complexity:** `O(1)`
