# Space Optimization

class Solution:
    def maximumPoints(self, arr):
        n = len(arr)

        prev = [0] * 4

        prev[0] = max(arr[0][1], arr[0][2])
        prev[1] = max(arr[0][0], arr[0][2])
        prev[2] = max(arr[0][0], arr[0][1])
        prev[3] = max(arr[0][0], arr[0][1], arr[0][2])

        for day in range(1, n):
            curr = [0] * 4
            for last in range(4):
                for task in range(3):
                    if task != last:
                        curr[last] = max(
                            curr[last],
                            arr[day][task] + prev[task]
                        )
            prev = curr

        return prev[3]
```

**Time Complexity:** `O(N × 4 × 3) = O(N)`
**Space Complexity:** `O(4) = O(1)`
