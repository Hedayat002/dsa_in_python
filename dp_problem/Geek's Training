# Memoization (Top-Down DP)

class Solution:
    def solve(self, day, last, arr, dp):
        if dp[day][last] != -1:
            return dp[day][last]

        if day == 0:
            maxi = 0
            for task in range(3):
                if task != last:
                    maxi = max(maxi, arr[0][task])
            dp[day][last] = maxi
            return dp[day][last]

        maxi = 0
        for task in range(3):
            if task != last:
                maxi = max(maxi, arr[day][task] + self.solve(day - 1, task, arr, dp))

        dp[day][last] = maxi
        return dp[day][last]

    def maximumPoints(self, arr):
        n = len(arr)
        dp = [[-1] * 4 for _ in range(n)]
        return self.solve(n - 1, 3, arr, dp)
```

**Time Complexity:** `O(N × 4 × 3) = O(N)`
**Space Complexity:** `O(N × 4) + O(N)`

