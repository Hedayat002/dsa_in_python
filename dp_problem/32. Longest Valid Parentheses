1. Recursion
class Solution:
    class Solution:
    def solve(self, i, s):
        n = len(s)
        if i >= n:
            return 0

        ans = 0
        if s[i] == '(' and i + 1 < n and s[i + 1] == ')':
            ans = 2 + self.solve(i + 2, s)

        return max(ans, self.solve(i + 1, s))

    def longestValidParentheses(self, s: str) -> int:
        return self.solve(0, s)

TC: Exponential
SC: O(n)

2. Memoization (Top-Down)
class Solution:
    def solve(self, i, s, dp):
        n = len(s)
        if i >= n:
            return 0

        if dp[i] != -1:
            return dp[i]

        ans = 0

        if s[i] == '(' and i + 1 < n and s[i + 1] == ')':
            ans = 2 + self.solve(i + 2, s, dp)

        dp[i] = max(ans, self.solve(i + 1, s, dp))
        return dp[i]

    def longestValidParentheses(self, s: str) -> int:
        n = len(s)
        dp = [-1] * n
        return self.solve(0, s, dp)

TC: O(n)
SC: O(n)

3. Tabulation (Bottom-Up)
class Solution:
    def longestValidParentheses(self, s: str) -> int:
        n = len(s)
        dp = [0] * n
        ans = 0

        for i in range(1, n):
            if s[i] == ')':
                if s[i - 1] == '(':
                    dp[i] = 2 + (dp[i - 2] if i >= 2 else 0)
                else:
                    j = i - dp[i - 1] - 1

                    if j >= 0 and s[j] == '(':
                        dp[i] = dp[i - 1] + 2
                        if j > 0:
                            dp[i] += dp[j - 1]

                ans = max(ans, dp[i])

        return ans

TC: O(n)
SC: O(n)
