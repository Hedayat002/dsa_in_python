Problem: 494. Target Sum
Platfom :Leetcode

1. Recursion
class Solution:
    def solve(self, i, currsum, target, nums):
        if i < 0:
            if currsum == target:
                return 1
            return 0
        plus = self.solve(i - 1, currsum + nums[i], target, nums)
        minus = self.solve(i - 1, currsum - nums[i], target, nums)
        return plus + minus
    def findTargetSumWays(self, nums: List[int], target: int) -> int:
        n = len(nums)
        sums = 0
        return self.solve(n - 1, sums, target, nums)

TC: O(2^n)
SC: O(n)
2. Memoization (Top-Down)

class Solution:
    def solve(self,i,currsum,target,nums,dp):
        if i < 0:
            if currsum == target:
                return 1
            return 0
        
        if dp[i][currsum] !=-1:
            return dp[i][currsum]  


        plus = self.solve(i-1,currsum+nums[i],target,nums,dp)

        minus = self.solve(i-1,currsum-nums[i],target,nums,dp)

        dp[i][currsum] = plus+minus

        return dp[i][currsum] 

    def findTargetSumWays(self, nums: List[int], target: int) -> int:
        n = len(nums)
        total = sum(nums)
        sums = 0
        dp = [[-1] * (2 * total + 1) for _ in range(n)]
        return self.solve(n-1,sums,target,nums,dp)
TC: O(n * sum(nums))
SC: O(n * sum(nums) + n)
3. Tabulation (Bottom-Up)
class Solution:

    def findTargetSumWays(self, nums: List[int], target: int) -> int:
        n = len(nums)
        total = sum(nums)
        sums = 0
        if target > total or target < -total:
            return 0
        dp = [[0] * (2 * total + 1) for _ in range(n)]
        offset = total

        dp[0][nums[0] + offset] += 1
        dp[0][-nums[0] + offset] += 1

        for i in range(1, n):
            for currsum in range(-total, total + 1):
                plus = dp[i-1][currsum+nums[i]]

                minus = dp[i-1][currsum-nums[i]]

                dp[i][currsum] = plus+minus

        return dp[n - 1][target + offset]
TC: O(n * sum(nums))
SC: O(n * sum(nums))

4. Space Optimization

class Solution:

    def findTargetSumWays(self, nums: List[int], target: int) -> int:
        n = len(nums)
        total = sum(nums)
        sums = 0
        if target > total or target < -total:
            return 0
        prev = [0] * (2 * total + 1)
        offset = total

        prev[nums[0] + offset] += 1
        prev[-nums[0] + offset] += 1

        for i in range(1, n):
            curr =[0] * (2 * total + 1)
            for currsum in range(-total, total + 1):
                plus = prev[currsum+nums[i]]

                minus = prev[currsum-nums[i]]

                curr[currsum] = plus+minus
            prev = curr


        return prev[target+offset]
TC: O(n * sum(nums))
SC: O(sum(nums))

