Problem : 115. Distinct Subsequences
Platform: Leetcode 

1. Recursion
class Solution:
    def solve(self, s, t, i, j):
        if j == len(t):
            return 1
        if i == len(s):
            return 0

        if s[i] == t[j]:
            return self.solve(s, t, i + 1, j + 1) + self.solve(s, t, i + 1, j)

        return self.solve(s, t, i + 1, j)

    def numDistinct(self, s: str, t: str) -> int:
        return self.solve(s, t, 0, 0)

TC: O(2^n)
SC: O(n)

2. Memoization (Top-Down)
class Solution:
    def solve(self, s, t, i, j, dp):
        if j == len(t):
            return 1
        if i == len(s):
            return 0

        if dp[i][j] != -1:
            return dp[i][j]

        if s[i] == t[j]:
            dp[i][j] = self.solve(s, t, i + 1, j + 1, dp) + self.solve(s, t, i + 1, j, dp)
        else:
            dp[i][j] = self.solve(s, t, i + 1, j, dp)

4. Space Optimization — prev and cur
class Solution:
    def numDistinct(self, s: str, t: str) -> int:
        n, m = len(s), len(t)

        prev = [0] * (m + 1)
        prev[0] = 1

        for i in range(1, n + 1):
            cur = [0] * (m + 1)
            cur[0] = 1

            for j in range(1, m + 1):
                if s[i - 1] == t[j - 1]:
                    cur[j] = prev[j - 1] + prev[j]
                else:
                    cur[j] = prev[j]

            prev = cur

        return prev[m]

TC: O(n × m)
SC: O(m)

