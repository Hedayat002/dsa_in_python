Problem: 516. Longest Palindromic Subsequence
Platform: Leetcode 

1. Recursion

Your recursion is correct:

class Solution:
    def solve(self, i, j, s):

        # No characters
        if i > j:
            return 0

        # One character
        if i == j:
            return 1

        # First and last characters match
        if s[i] == s[j]:
            return 2 + self.solve(i + 1, j - 1, s)

        # First and last characters don't match
        return max(
            self.solve(i + 1, j, s),
            self.solve(i, j - 1, s)
        )

    def longestPalindromeSubseq(self, s: str):
        n = len(s)

        return self.solve(0, n - 1, s)

Time: 	O(2ⁿ)	
Space: O(n)

2. Memoization — Top Down

class Solution:
    def solve(self, i, j, s,dp):

        # Base case
        if i > j:
            return 0

        # One character
        if i == j:
            return 1

        if dp[i][j] != -1:
            return dp[i][j]

        # If first and last characters are same
        if s[i] == s[j]:
            return 2 + self.solve(i + 1, j - 1, s,dp)

        # If first and last characters are different
        else: 
            dp[i][j] = max(self.solve(i + 1, j, s,dp),self.solve(i, j - 1, s,dp))

        return dp[i][j]


    def longestPalindromeSubseq(self, s: str) -> int:
        n = len(s)
        dp = [[-1] * n for _ in range(n)]

        return self.solve(0, n - 1, s,dp)

tc: O(n²)
sc: O(n²) + O(n)

3. Tabulation — Bottom Up
class Solution:
    def longestPalindromeSubseq(self, s: str) -> int:
        n = len(s)
        dp = [[0] * n for _ in range(n)]

        for k in range(n):
            dp[k][k] = 1

        for i in range(2, n + 1):

            for j in range(n - i + 1):
                    k = j + i - 1
                    if s[j] == s[k]:
                        dp[j][k] = 2 + dp[j + 1][k - 1] if i > 2 else 2
                    # If first and last characters are different
                    else: 
                        dp[j][k] = max(dp[j + 1][ k],dp[j][ k - 1])

        return dp[0][n - 1]
tc:O(n²)
sc:O(n²)

Space Optimization
class Solution:
    def longestPalindromeSubseq(self, s: str) -> int:
        n = len(s)

        prev = [1] * n
        prev2 = [0] * n

        for i in range(2, n + 1):
            curr = [0] * n

            for j in range(n - i + 1):
                k = j + i - 1

                if s[j] == s[k]:
                    curr[j] = 2 + (prev2[j + 1] if i > 2 else 0)

                else:
                    curr[j] = max(prev[j], prev[j + 1])

            prev2 = prev
            prev = curr

        return prev[0]

TC: O(n²)
SC: O(n)
