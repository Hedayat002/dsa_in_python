## Approach 3: Space Optimized (Exact C++ Conversion)

```python
class Solution:
    def stoneGameIII(self, stoneValue: List[int]) -> str:
        n = len(stoneValue)

        # a = dp[i+1], b = dp[i+2], c = dp[i+3]
        a = b = c = 0

        for i in range(n - 1, -1, -1):

            ans = stoneValue[i] - a

            if i + 1 < n:
                ans = max(ans,
                          stoneValue[i] + stoneValue[i + 1] - b)

            if i + 2 < n:
                ans = max(ans,
                          stoneValue[i] + stoneValue[i + 1] + stoneValue[i + 2] - c)

            # Shift
            c = b
            b = a
            a = ans

        if a > 0:
            return "Alice"
        elif a < 0:
            return "Bob"
        return "Tie"
```

**Time:** `O(n)`
**Space:** `O(1)`

