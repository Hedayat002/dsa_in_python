## Approach 4: MiniMax Game Theory

```python
class Solution:
    def stoneGameIII(self, stoneValue: List[int]) -> str:
        n = len(stoneValue)

        ALICE = 1
        BOB = 0

        dp = [[-1] * (n + 1) for _ in range(2)]

        def minimax(player, i):
            if i >= n:
                return 0

            if dp[player][i] != -1:
                return dp[player][i]

            if player == ALICE:
                result = float("-inf")
            else:
                result = float("inf")

            stones = 0

            for j in range(i, min(i + 3, n)):
                if player == ALICE:
                    stones += stoneValue[j]
                    result = max(result,
                                 stones + minimax(BOB, j + 1))
                else:
                    stones -= stoneValue[j]
                    result = min(result,
                                 stones + minimax(ALICE, j + 1))

            dp[player][i] = result
            return result

        diff = minimax(ALICE, 0)

        if diff > 0:
            return "Alice"
        elif diff < 0:
            return "Bob"
        return "Tie"
```

**Time:** `O(n)`
**Space:** `O(n)`
