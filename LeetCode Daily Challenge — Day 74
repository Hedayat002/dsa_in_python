## 2. Better — Backtracking + Frequency Count

```python
class Solution:
    def __init__(self):
        self.result = ""

    def solve(self, curr, count, target, i, greater):
        if i == len(target):
            if greater:
                self.result = curr
                return True
            return False

        for ch in range(ord('a'), ord('z') + 1):
            idx = ch - ord('a')

            if count[idx] == 0:
                continue

            char = chr(ch)

            if not greater and char < target[i]:
                continue

            curr += char
            count[idx] -= 1

            isGreater = greater or char > target[i]

            if self.solve(curr, count, target, i + 1, isGreater):
                return True

            count[idx] += 1
            curr = curr[:-1]

        return False

    def lexGreaterPermutation(self, s: str, target: str) -> str:
        count = [0] * 26

        for ch in s:
            count[ord(ch) - ord('a')] += 1

        self.solve("", count, target, 0, False)

        return self.result
```

**TC:** `O(26 · n)` best-case, `O(26^n)` worst-case
**SC:** `O(n + 26)`

