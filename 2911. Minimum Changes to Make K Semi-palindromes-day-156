
# 2911. Minimum Changes to Make K Semi-palindromes

---

## 1. Recursion

```python
class Solution:
    def getCost(self, s, i, j):
        length = j - i + 1
        minCost = float('inf')

        for d in range(1, length):
            if length % d != 0:
                continue

            cost = 0

            for group in range(d):
                l = i + group
                r = l + (length // d - 1) * d

                while l < r:
                    if s[l] != s[r]:
                        cost += 1

                    l += d
                    r -= d

            minCost = min(minCost, cost)

        return minCost

    def solve(self, s, start, k):
        n = len(s)

        if k == 0:
            return 0 if start == n else float('inf')

        if start + 2 * k > n:
            return float('inf')

        result = float('inf')

        for end in range(start + 1, n - 2 * (k - 1)):
            remaining = self.solve(s, end + 1, k - 1)

            result = min(
                result,
                self.getCost(s, start, end) + remaining
            )

        return result

    def minimumChanges(self, s: str, k: int) -> int:
        return self.solve(s, 0, k)
```

**Time Complexity:** O(n² log n × C(n-k-1, k-1))  
**Space Complexity:** O(k)

