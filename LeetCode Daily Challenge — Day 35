# Brute Force Code (Python)

```python
class Solution:
    def removeDuplicateLetters(self, s: str) -> str:

        unique = set(s)
        n = len(s)

        ans = None

        for mask in range(1 << n):

            subseq = []

            for i in range(n):
                if mask & (1 << i):
                    subseq.append(s[i])

            subseq = "".join(subseq)

            if len(subseq) != len(unique):
                continue

            if len(set(subseq)) != len(unique):
                continue

            if set(subseq) != unique:
                continue

            if ans is None or subseq < ans:
                ans = subseq

        return ans
```

