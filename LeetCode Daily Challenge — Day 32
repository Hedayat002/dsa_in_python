# Optimal Code

```python
from math import gcd

class Solution:
    def sumGCD(self, nums):

        if not nums:
            return 0

        n = len(nums)
        prefixGcd = [0] * n
        mxi = 0

        for i in range(n):
            mxi = max(mxi, nums[i])
            prefixGcd[i] = gcd(nums[i], mxi)

        prefixGcd.sort()

        ans = 0
        l = 0
        r = n - 1

        while l < r:
            ans += gcd(prefixGcd[l], prefixGcd[r])
            l += 1
            r -= 1

        return ans
```

