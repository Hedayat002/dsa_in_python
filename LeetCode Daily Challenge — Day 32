# Brute Force Code (Python)

```python
from math import gcd

class Solution:
    def sumGCD(self, nums):
        n = len(nums)

        prefixGcd = []

        for i in range(n):

            mx = nums[0]

            for j in range(i + 1):
                mx = max(mx, nums[j])

            prefixGcd.append(gcd(nums[i], mx))

        prefixGcd.sort()

        ans = 0

        l = 0
        r = n - 1

        while l < r:
            ans += gcd(prefixGcd[l], prefixGcd[r])
            l += 1
            r -= 1

        return ans
```

